CORS_ORIGINS=["http://localhost:5173"]

DB_DRIVER=sqlite3
# DATABASE_URL=            # 最高优先级；与 DB_DRIVER 冲突时启动报错（详见 docs/DATABASE.md）
# SQLITE_PATH=./data/app.db
# APP_DATA_DIR=./data

# MySQL 示例（目标库必须已存在且账号有 ALL PRIVILEGES）
# DB_DRIVER=mysql
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/casx?charset=utf8mb4
# 或者用离散字段拼装（未设 DATABASE_URL 时生效）：
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=casx
# DB_USER=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# MySQL 连接池（可选）
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20
# DB_POOL_RECYCLE_SECONDS=3600

REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

MEDIA_PROXY_IMAGE_CACHE_ENABLED=true
MEDIA_PROXY_IMAGE_CACHE_TTL_SECONDS=86400
MEDIA_PROXY_IMAGE_CACHE_MAX_FILE_BYTES=10485760
MEDIA_PROXY_IMAGE_CACHE_MAX_TOTAL_BYTES=536870912
# MEDIA_PROXY_IMAGE_CACHE_DIR=./data/cache/proxy_image

# 追剧任务自动调度随机休眠（秒，0 表示关闭）
DRAMA_SCHEDULE_RANDOM_DELAY_MAX_SECONDS=300
DRAMA_SCHEDULE_TASK_INTERVAL_MAX_SECONDS=30
